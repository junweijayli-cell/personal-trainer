# Public values embedded into the static frontend
DEPLOY_TARGET=cloudflare-pages
NEXT_PUBLIC_SITE_URL=https://trainwell.win
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_MARKET=global
# Set false until custom SMTP and the six-digit confirmation template are verified.
NEXT_PUBLIC_SIGNUP_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Supabase Edge Function secrets; never expose these as NEXT_PUBLIC values
APP_URL=https://trainwell.win
ALLOWED_ORIGINS=https://trainwell.win,https://www.trainwell.win,https://junweijayli-cell.github.io,http://localhost:3000
APP_MARKET=global
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_CN_ANNUAL=price_REPLACE_ME
STRIPE_CURRENCY_GLOBAL=usd
STRIPE_CURRENCY_CN=cny
SENTRY_DSN=

# Separate live credentials and approved prices. Cutover is controlled in billing_runtime.
STRIPE_LIVE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_LIVE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_LIVE_PRICE_DAILY=price_REPLACE_ME
STRIPE_LIVE_PRICE_MONTHLY=price_REPLACE_ME
STRIPE_LIVE_PRICE_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_DAILY=price_REPLACE_ME
